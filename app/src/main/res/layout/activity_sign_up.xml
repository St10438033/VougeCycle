<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Brand title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VougeCycle"
            android:textColor="@color/vc_green"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <!-- Taglines -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buy vintage · Sell vintage · Keep fashion in motion"
            android:textColor="@color/vc_grey_text"
            android:textSize="12sp"/>

        <!-- Screen heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Sign Up"
            android:textColor="@color/vc_black"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter in down below"
            android:textColor="@color/vc_grey_text"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Full Name -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_field"
            android:hint="Full Name"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:importantForAutofill="no"/>

        <!-- Username -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Username"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="text"
            android:importantForAutofill="no"/>

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Password"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:importantForAutofill="no"/>

        <!-- Password hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Password must least 6 character, contain number and capital"
            android:textColor="@color/vc_grey_text"
            android:textSize="11sp"/>

        <!-- Confirm Password -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Confirm Password"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:importantForAutofill="no"/>

        <!-- Sign Up button -->
        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="Sign Up"
            android:textColor="@color/vc_white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"/>

        <!-- Log In link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Have an account? "
                android:textColor="@color/vc_grey_text"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log In"
                android:textColor="@color/vc_green"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Permission note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="We need permission for the service you use\nLearn More"
            android:textColor="@color/vc_grey_text"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>