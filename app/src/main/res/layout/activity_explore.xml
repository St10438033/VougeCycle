<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vc_white">

    <!-- ====== SEARCH BAR ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search items and shops"
                android:textSize="14sp"
                android:inputType="text"
                android:importantForAutofill="no"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ====== CATEGORY CHIPS ====== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="All"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipWomen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Women"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipMen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Men"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipVintage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Vintage"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/chipSports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Sports"
                android:textColor="@color/vc_black"
                android:textSize="13sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ====== PRODUCT GRID (weight=1 so it fills the middle) ====== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="14dp"
        android:clipToPadding="false"/>

    <!-- ====== BOTTOM NAV ====== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vc_border"/>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"/>

</LinearLayout>