<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vc_white"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Brand title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="VougeCycle"
        android:textColor="@color/vc_green"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <!-- Taglines -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Buy vintage · Sell vintage · Keep fashion in motion"
        android:textColor="@color/vc_grey_text"
        android:textSize="12sp"/>

    <!-- Screen heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Forgot Password"
        android:textColor="@color/vc_black"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <!-- Explanation text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Enter your email, phone, or username and we'll send you a link to change a new password."
        android:textColor="@color/vc_grey_text"
        android:textSize="14sp"/>

    <!-- Input field -->
    <EditText
        android:id="@+id/etIdentifier"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_input_field"
        android:hint="Username, Email or Phone Number"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="textEmailAddress"
        android:importantForAutofill="no"/>

    <!-- Send button -->
    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="Send"
        android:textColor="@color/vc_white"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:stateListAnimator="@null"/>

</LinearLayout>